generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  phone     String?  @unique
  role      String   @default("CUSTOMER")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Application {
  id              String   @id @default(uuid())
  applicationId   String   @unique

  fullName        String
  mobile          String
  email           String
  service         String

  address         String
  district        String
  state           String
  pincode         String
  remarks         String?

  status          String   @default("Pending")
  submittedAt     DateTime @default(now())

  leadId          String?
  leadSyncStatus  String   @default("PENDING")
}