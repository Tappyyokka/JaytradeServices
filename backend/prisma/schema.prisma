
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  accountId    String?  @unique @db.VarChar(12)
  name         String
  email        String   @unique
  password     String
  phone        String?  @unique
  role         String   @default("CUSTOMER")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications Application[]
  marketplaceStore MarketplaceStore?
  marketplaceWallet MarketplaceWallet?
  marketplaceOrders MarketplaceOrder[]
    // Referral system
  referralCode String? @unique @db.VarChar(20)
  referredById String?

  referrer User?  @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals User[] @relation("UserReferrals")

  @@index([referredById])
}

model MarketplaceStore {
  userId String @id
  user User @relation(fields: [userId], references: [id])
  name String
  description String
  products MarketplaceProduct[]
}

model MarketplaceProduct {
  id String @id @default(uuid())
  sellerId String
  store MarketplaceStore @relation(fields: [sellerId], references: [userId])
  name String
  description String
  category String
  price Int
  original Int
  stock Int
  image String
  active Boolean @default(true)
  @@index([sellerId])
}

model MarketplaceWallet {
  userId String @id
  user User @relation(fields: [userId], references: [id])
  balance Int @default(0)
  entries MarketplaceLedgerEntry[]
}

model MarketplaceLedgerEntry {
  id String @id @default(uuid())
  userId String
  wallet MarketplaceWallet @relation(fields: [userId], references: [userId])
  amount Int
  reference String @unique
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model MarketplaceOrder {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id])
  lines Json
  total Int
  sellerStage Int @default(0)
  refunded Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model Application {
  id              String   @id @default(uuid())
  applicationId   String   @unique

  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Restrict)

  fullName        String
  mobile          String
  email           String
  service         String

  address         String
  district        String
  state           String
  pincode         String
  remarks         String?

  status          String   @default("Pending")
  submittedAt     DateTime @default(now())

  leadId          String?
  leadSyncStatus  String   @default("PENDING")

  @@index([userId])
}
